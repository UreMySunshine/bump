# ── 版本解析 ──────────────────────────────────────────────────────────────

def parse_version(text):
    """把版本串解析成 (数字元组, 是否正式版)。无法解析时返回 None。

    Homebrew 的部分 formula（如 ca-certificates）用日期作版本号，形如 2026-09-25，
    按连字符分隔的多段数字处理，否则会被截成单段 2026 而无法比较。
    """
    if not text:
        return None
    date = re.match(r"^\s*v?(\d{4})-(\d{2})-(\d{2})\b", text)
    if date:
        return ((int(date.group(1)), int(date.group(2)), int(date.group(3))), 1)
    m = re.search(r"(\d+(?:\.\d+)*)(?:[-+~]?([0-9A-Za-z.\-+]*))?", text.strip())
    if not m:
        return None
    return (tuple(int(p) for p in m.group(1).split(".")), 0 if m.group(2) else 1)


def is_newer(latest, local):
    a, b = parse_version(latest), parse_version(local)
    if a is None or b is None:
        return False
    width = max(len(a[0]), len(b[0]))
    an = a[0] + (0,) * (width - len(a[0]))
    bn = b[0] + (0,) * (width - len(b[0]))
    if an != bn:
        return an > bn
    return a[1] > b[1]


def short_version(text, limit=16):
    """从命令输出里取出纯版本号，避免整行塞进表格。"""
    if not text:
        return "?"
    for token in text.strip().split():
        if re.match(r"^v?\d+(\.\d+)*", token):
            return token[:limit]
    return text.strip().split()[0][:limit]


# ── 子进程与网络 ──────────────────────────────────────────────────────────

def run(cmd, timeout=CHECK_TIMEOUT):
    """执行命令。可执行文件不存在或执行失败时返回 None。"""
    if not shutil.which(cmd[0]):
        return None
    try:
        return subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            stdin=subprocess.DEVNULL,
            env=dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1", NO_COLOR="1"),
        )
    except (subprocess.TimeoutExpired, OSError):
        return None


_http_cache = {}
_http_lock = threading.Lock()


def http_text(url):
    with _http_lock:
        cached = _http_cache.get(url)
    if cached is not None:
        return cached
    req = urllib.request.Request(url, headers={"User-Agent": "bump/1.0"})
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
        body = resp.read().decode("utf-8", "replace")
    with _http_lock:
        _http_cache[url] = body
    return body


def npm_latest(package):
    quoted = urllib.parse.quote(package, safe="")
    return json.loads(http_text("https://registry.npmjs.org/%s/latest" % quoted))["version"]


def toml_version(text, section=None):
    """读取 TOML 中某个 [section] 下（或文件顶层）的 version 字段。"""
    body = text
    if section:
        start = text.find("[%s]" % section)
        if start < 0:
            return None
        body = text[start:]
        nxt = body.find("\n[", 1)
        if nxt > 0:
            body = body[:nxt]
    m = re.search(r"^version\s*=\s*['\"]([^'\"]+)['\"]", body, re.MULTILINE)
    return m.group(1) if m else None


# ── 数据模型 ──────────────────────────────────────────────────────────────

class Tool:
    def __init__(self, key, group, name, update_cmd=None, authoritative=False):
        self.key = key
        self.group = group
        self.name = name
        self.update_cmd = update_cmd
        self.authoritative = authoritative   # 包管理器已直接判定为过期，无需再比版本
        self.local = None
        self.latest = None
        self.state = "done"                  # done | unknown
        self.reason = ""
        self.pinned = False
        self.updating = None                 # None | running | ok | failed
        self.update_msg = ""

    @property
    def outdated(self):
        if self.pinned or self.state != "done":
            return False
        if self.authoritative:
            # 包管理器已判定过期，但它对日期型版本号（如 Homebrew 的 2026-09-25）
            # 无法用数值比较，因此只排除两边字符串完全相同的情况
            return self.local != self.latest
        return self.state == "done" and is_newer(self.latest, self.local)

    @property
    def sort_key(self):
        return (0 if self.outdated else 1, self.group, self.name.lower())


# ── 检测器：每个函数结束时发 group_done ───────────────────────────────────

def command_json(cmd, allowed=(0,)):
    result = run(cmd)
    if result is None:
        raise RuntimeError('%s 无法执行或已超时' % cmd[0])
    try:
        data = json.loads(result.stdout)
    except ValueError:
        raise RuntimeError((result.stderr.strip() or '命令没有返回有效 JSON')[:120])
    if isinstance(data, dict) and data.get('error'):
        error = data['error']
        raise RuntimeError(str(error.get('summary') or error)[:120])
    if result.returncode not in allowed:
        raise RuntimeError((result.stderr.strip() or '命令退出码 %s' % result.returncode)[:120])
    return data


def check_brew(publish):
    inventory = command_json(['brew', 'info', '--json=v2', '--installed'])
    problem = ''
    try:
        outdated = command_json(['brew', 'outdated', '--json=v2'])
    except RuntimeError as exc:
        outdated = {}
        problem = str(exc)
        publish(('error', ('brew', problem)))
    for kind, field in [('formula', 'formulae'), ('cask', 'casks')]:
        updates = {item['name']: item for item in outdated.get(field, [])}
        for item in inventory.get(field, []):
            name = item.get('name') if kind == 'formula' else item['token']
            tool = Tool('%s:%s' % (kind, name), 'brew', name,
                        ['brew', 'upgrade'] + (['--cask'] if kind == 'cask' else []) + [name],
                        authoritative=True)
            installed = item.get('installed') or []
            if kind == 'formula':
                versions = [entry['version'] for entry in installed]
                tool.local = ', '.join(versions) or '?'
                tool.description = item.get('desc') or ''
                tool.dependency = not any(entry.get('installed_on_request') for entry in installed)
            else:
                tool.local = installed if isinstance(installed, str) else ', '.join(installed)
                tool.description = item.get('desc') or ''
            update = updates.get(name) or updates.get(item.get('full_name'))
            tool.latest = update.get('current_version') if update else tool.local
            tool.pinned = bool(item.get('pinned'))
            if problem or not tool.local or tool.local == '?' or not tool.latest:
                tool.state, tool.reason = 'unknown', problem or '版本信息不完整'
            publish(('tool', tool))
    publish(('group_done', 'brew'))


def check_npm(publish):
    inventory = command_json(['npm', 'list', '-g', '--depth=0', '--json'], allowed=(0, 1))
    problem = ''
    try:
        outdated = command_json(['npm', 'outdated', '-g', '--json'], allowed=(0, 1))
    except RuntimeError as exc:
        outdated = {}
        problem = str(exc)
        publish(('error', ('npm', problem)))
    for name, info in inventory.get('dependencies', {}).items():
        tool = Tool('npm:%s' % name, 'npm', name,
                    ['npm', 'install', '-g', '%s@latest' % name], authoritative=True)
        tool.local = info.get('version') or '?'
        tool.latest = outdated.get(name, {}).get('latest') or tool.local
        if problem or tool.local == '?':
            tool.state, tool.reason = 'unknown', problem or '无法读取已安装版本'
        publish(('tool', tool))
    publish(('group_done', 'npm'))


def _opencode_latest():
    # opencode 的 2.x 发布在 @opencode/cli，1.x 发布在 opencode-ai，两条线并行
    result = run(["opencode", "--version"], timeout=60)
    parsed = parse_version(result.stdout) if result and result.stdout.strip() else None
    major = parsed[0][0] if parsed else 2
    return npm_latest("@opencode/cli" if major >= 2 else "opencode-ai")


def _cmd_version(cmd):
    """执行 `--version` 类命令，返回标准输出。"""
    result = run(cmd, timeout=60)
    return result.stdout.strip() if result and result.returncode == 0 and result.stdout.strip() else None


def _pi_local():
    path = os.path.expanduser("~/.pi/agent/install/current-version")
    if os.path.exists(path):
        with open(path) as fh:
            value = fh.read().strip()
        if value:
            return value
    return _cmd_version(["pi", "--version"])


# 仅对用户明确指定的独立安装路径使用官方安装脚本。
UV_STANDALONE_PATH = os.environ.get("BUMP_UV_STANDALONE_PATH", "")


def uv_update_command():
    executable = shutil.which("uv")
    if executable != UV_STANDALONE_PATH or os.path.islink(executable):
        return ["uv", "self", "update"], ""
    script = """set -eu
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT
curl --proto '=https' --tlsv1.2 -fLsS https://astral.sh/uv/install.sh -o "$installer"
env UV_INSTALL_DIR="$1" UV_NO_MODIFY_PATH=1 sh "$installer"
"""
    return ["/bin/sh", "-c", script, "bump-uv-update", os.path.dirname(executable)], (
        "通过 Astral 官方安装脚本更新至原目录；不修改 shell 配置")


SELF_SPECS = [
    ("bun", "Bun", lambda: _cmd_version(["bun", "-v"]), lambda: npm_latest("bun"),
     ["bun", "upgrade"]),
    ("rustup", "rustup", lambda: _cmd_version(["rustup", "--version"]),
     lambda: toml_version(http_text("https://static.rust-lang.org/rustup/release-stable.toml")),
     ["rustup", "self", "update"]),
    ("rust", "Rust (stable)", lambda: _cmd_version(["rustc", "--version"]),
     lambda: toml_version(
         http_text("https://static.rust-lang.org/dist/channel-rust-stable.toml"), "pkg.rust"),
     ["rustup", "update"]),
    ("uv", "uv", lambda: _cmd_version(["uv", "--version"]),
     lambda: json.loads(http_text("https://pypi.org/pypi/uv/json"))["info"]["version"],
     ["uv", "self", "update"]),
    ("opencode", "opencode", lambda: _cmd_version(["opencode", "--version"]),
     _opencode_latest, ["opencode", "upgrade"]),
    ("pi", "pi", _pi_local, lambda: npm_latest("@earendil-works/pi-coding-agent"),
     ["pi", "update", "--self"]),
    ("claude", "Claude Code", lambda: _cmd_version(["claude", "--version"]),
     lambda: npm_latest("@anthropic-ai/claude-code"), ["claude", "update"]),
]


def _check_one(spec):
    key, name, local_fn, latest_fn, update_cmd = spec
    tool = Tool(key, "self", name, update_cmd)
    if key == "uv":
        tool.update_cmd, tool.description = uv_update_command()
    try:
        local = local_fn()
        if not local:
            raise RuntimeError("无法读取本地版本")
        tool.local = local
        tool.latest = latest_fn()
        if not tool.latest:
            raise RuntimeError("无法获取最新版本")
    except Exception as exc:
        tool.state = "unknown"
        tool.reason = str(exc).splitlines()[0][:56] or exc.__class__.__name__
    return tool


def check_self(publish):
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(SELF_SPECS)) as pool:
        futures = [pool.submit(_check_one, spec) for spec in SELF_SPECS]
        for future in concurrent.futures.as_completed(futures):
            publish(("tool", future.result()))
    publish(("group_done", "self"))


def collect(publish):
    def guarded(group, checker):
        try:
            checker(publish)
        except Exception as exc:                 # 单个检测器失败不应卡住整体流程
            publish(("error", (group, (str(exc) or type(exc).__name__).splitlines()[0][:80])))
            publish(("group_done", group))

    for group, checker in (("brew", check_brew), ("npm", check_npm), ("self", check_self)):
        threading.Thread(target=guarded, args=(group, checker), daemon=True).start()


def gather_blocking(on_progress=None):
    events = queue.Queue()
    collect(events.put)
    tools, errors, done = [], [], set()
    frame = 0
    while len(done) < len(GROUPS):
        try:
            kind, payload = events.get(timeout=0.08)
        except queue.Empty:
            if on_progress:
                on_progress(frame, len(tools))
                frame += 1
            continue
        if kind == "tool":
            tools.append(payload)
            if on_progress:
                on_progress(frame, len(tools))
                frame += 1
        elif kind == "error":
            errors.append(payload)
        elif kind == "group_done":
            done.add(payload)
    return tools, errors


# ── 更新执行 ──────────────────────────────────────────────────────────────

def update_stage(line):
    if re.search(r'\b(unpack\w*|extract\w*|pouring|install\w*|building|linking)\b|安装|解压|构建', line, re.I):
        return '正在安装'
    if re.search(r'\b(download\w*|fetch\w*|receiv\w*|retriev\w*)\b|下载', line, re.I):
        return '正在下载'
    return None


def run_update(tool, on_output=None):
    if not tool.update_cmd:
        return False, "没有可用的更新命令"
    try:
        proc = subprocess.Popen(
            tool.update_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            text=True,
            errors='replace',
        )
        lines = []
        finished = threading.Event()
        def read_output():
            with proc.stdout:
                for raw in proc.stdout:
                    if finished.is_set():
                        break
                    line = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', raw).strip()
                    if line:
                        lines.append(line)
                        if on_output:
                            on_output(line)
        reader = threading.Thread(target=read_output, daemon=True)
        reader.start()
        timed_out = False
        try:
            proc.wait(timeout=UPDATE_TIMEOUT)
        except subprocess.TimeoutExpired:
            timed_out = True
            proc.kill()
            proc.wait()
        reader.join(timeout=2)
        finished.set()
        if timed_out:
            return False, '更新超时\n' + '\n'.join(lines)
        return proc.returncode == 0, ("\n".join(lines) or "命令退出码 %s" % proc.returncode)
    except OSError as exc:
        return False, str(exc)


# ── 纯文本输出 ────────────────────────────────────────────────────────────

class Palette:
    def __init__(self, enabled):
        self.enabled = enabled

    def _wrap(self, code, text):
        return "\033[%sm%s\033[0m" % (code, text) if self.enabled else text

    def dim(self, t):
        return self._wrap("2", t)

    def bold(self, t):
        return self._wrap("1", t)

    def ok(self, t):
        return self._wrap("32", t)

    def warn(self, t):
        return self._wrap("33", t)

    def err(self, t):
        return self._wrap("31", t)

    def accent(self, t):
        return self._wrap("36", t)


def print_plain(tools, errors, color=True):
    pal = Palette(color and sys.stdout.isatty())
    tools = sorted(tools, key=lambda t: t.sort_key)
    outdated = [t for t in tools if t.outdated]
    width = max([len(t.name) for t in tools] + [12])

    print()
    print("  " + pal.bold(pal.accent("BUMP")) + pal.dim("  ·  package update cockpit"))
    print(pal.dim("  " + "─" * 66))
    if not tools:
        print(pal.dim("  没有检测到可管理的工具"))
    for tool in tools:
        if tool.outdated:
            line = "  %s %-*s %s %s %s" % (
                pal.warn("↑"), width, tool.name,
                pal.dim(short_version(tool.local)),
                pal.dim("→"), pal.ok(short_version(tool.latest)))
        elif tool.state == "unknown":
            line = "  %s %-*s %s" % (pal.err("?"), width, tool.name, pal.dim(tool.reason))
        elif tool.pinned:
            line = "  %s %-*s %s" % (pal.dim("·"), width, tool.name, pal.dim("已固定"))
        else:
            line = "  %s %-*s %s" % (pal.ok("✓"), width, tool.name,
                                     pal.dim(short_version(tool.local)))
        print(line)

    for group, message in errors:
        print("  %s %s: %s" % (pal.err("!"), group, message))

    unknown = len([t for t in tools if t.state == "unknown"])
    fresh = len([t for t in tools if t.state == "done" and not t.outdated and not t.pinned])
    print(pal.dim("  " + "─" * 66))
    print("  %s   %s   %s" % (
        pal.warn("%d 个可更新" % len(outdated)),
        pal.ok("%d 个已最新" % fresh),
        pal.dim("%d 个未知" % unknown) if unknown else pal.dim(""),
    ))
    if outdated:
        print(pal.dim("  使用 --json 获取机器可读结果，或在终端直接运行进入交互界面"))
    print()
    return len(outdated)


def print_progress(frame, count):
    sys.stdout.write("\r  %s  正在检测… 已发现 %d 项" % (SPINNER[frame % len(SPINNER)], count))
    sys.stdout.flush()


