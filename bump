    #masthead { height: 5; padding: 1 3; background: $bump-surface; }
    #brand { width: 1fr; color: $bump-accent; text-style: bold; }
    #theme-toggle { width: 16; margin-left: 2; }
    #subtitle { width: 36; color: $bump-muted; content-align: right middle; }
    #metrics { height: 5; margin: 1 3; }
    .metric { width: 1fr; height: 5; padding: 0 2; margin-right: 1; border: round $bump-border; background: $bump-surface; }
    #updates { border: round $bump-accent-border; color: $bump-accent; }
    #filters { height: 3; margin: 0 3 1 3; }
    #search { width: 1fr; margin-right: 1; }
    Select { width: 22; margin-left: 1; }
    Input, SelectCurrent { background: $bump-input; border: tall $bump-border; }
    Input:focus, Select:focus SelectCurrent { border: tall $bump-accent; }
    #table-box { height: 1fr; margin: 0 3; border: round $bump-border; background: $bump-table; }
    #table-heading { height: 2; padding: 0 2; color: $bump-muted; }
    DataTable { height: 1fr; background: $bump-table; padding: 0 1; }
    DataTable > .datatable--header { background: $bump-header; color: $bump-muted; text-style: bold; }
    DataTable > .datatable--odd-row { background: $bump-stripe; }
    DataTable > .datatable--even-row { background: $bump-table; }
    DataTable > .datatable--cursor { background: $bump-cursor; color: $bump-cursor-text; text-style: none; }
    Screen.terminal-mode DataTable > .datatable--cursor { background: ansi_default; color: ansi_default; text-style: reverse; }
    #detail { height: 3; padding: 1 3 0 3; color: $bump-muted; }
    #update-progress-box { display: none; height: 10; max-height: 45%; margin: 0 3; border: round $bump-accent-border; background: $bump-table; }
    #update-progress-box.active { display: block; }
    #update-progress-box.running { height: 1fr; max-height: 100%; }
    #update-summary { height: 2; padding: 0 1; color: $bump-accent; }
    #actions { height: 3; margin: 0 3 1 3; }
    #status { width: 1fr; content-align: left middle; color: $bump-muted; }
    Button { min-width: 14; margin-left: 1; border: none; background: $bump-button; }
    Button.-primary { background: $bump-accent; color: $bump-bg; text-style: bold; }
    Footer { background: $bump-surface; color: $bump-muted; }
    '''
    BINDINGS = [Binding('slash', 'search', '搜索'), Binding('space', 'toggle', '选择'),
                Binding('ctrl+a', 'select_visible', '选择可更新'), Binding('ctrl+n', 'clear', '清空'),
                Binding('ctrl+t', 'theme_toggle', '切换主题'),
                Binding('ctrl+r', 'refresh', '刷新'), Binding('ctrl+q', 'quit', '退出')]

    def __init__(self):
        super().__init__()
        for mode, palette in PALETTES.items():
            self.register_theme(Theme(name='bump-' + mode, dark=mode != 'light', ansi=mode == 'terminal',
                                      primary=palette['bump-accent'],
                                      background=palette['bump-bg'], foreground=palette['bump-text'],
                                      surface=palette['bump-surface'], panel=palette['bump-header'],
                                      variables={**BUILTIN_THEMES['ansi-dark'].variables, **palette}))
        self.theme_mode = load_theme_mode()
        self.theme = 'bump-' + self.theme_mode
        self.tools = {}
        self.errors = []
        self.selected = set()
        self.events = queue.Queue()
        self.done = set()
        self.checking = False
        self.updating = False
        self.filtered_tools = []
        self.last_update_result = ''

    def compose(self) -> ComposeResult:
        with Horizontal(id='masthead'):
            yield Static('B U M P\n本机工具管理', id='brand')
            yield Static('完整清单 · 按需更新', id='subtitle')
            yield Button(THEME_LABELS[self.theme_mode], id='theme-toggle')
        with Horizontal(id='metrics'):
            yield Static('—\n已安装', id='installed', classes='metric')
            yield Static('—\n可更新', id='updates', classes='metric')
            yield Static('—\n已最新', id='fresh', classes='metric')
            yield Static('—\n未知 / 固定', id='unknown', classes='metric')
        with Horizontal(id='filters'):
            yield Input(placeholder='搜索工具名称…', id='search')
            yield Select([('全部来源', 'all'), ('Homebrew', 'brew'), ('npm 全局', 'npm'),
                          ('独立工具', 'self')], value='all', allow_blank=False, id='source')
            yield Select([('全部状态', 'all'), ('可更新', 'updates'), ('已最新', 'fresh'),
                          ('未知', 'unknown'), ('已固定', 'pinned')], value='all',
                         allow_blank=False, id='state')
        with Vertical(id='table-box'):
            yield Static('正在读取安装清单', id='table-heading')
            yield PackageTable(id='packages', cursor_type='row', zebra_stripes=True)
        yield Static('选择一项查看详情', id='detail')
        with Vertical(id='update-progress-box'):
            yield Static('', id='update-summary')
            yield DataTable(id='update-items', cursor_type='none', zebra_stripes=True)
        with Horizontal(id='actions'):
            yield Static('准备检查', id='status')
            yield Button('更新结果', id='result-button', disabled=True)
            yield Button('重新检查', id='refresh')
            yield Button('更新所选 (0)', id='update', variant='primary', disabled=True)
        yield Footer()

    def on_mount(self):
        self.screen.set_class(self.theme_mode == 'terminal', 'terminal-mode')
        table = self.query_one(DataTable)
        for title, width in [('选择', 5), ('工具', 38), ('来源', 12), ('本地版本', 21), ('目标版本', 18), ('状态', 12)]:
            table.add_column(title, width=width)
        progress = self.query_one('#update-items', DataTable)
        for title, key, width in [('更新项目', 'name', 30), ('当前状态', 'stage', 14), ('最近输出', 'detail', 66)]:
            progress.add_column(title, key=key, width=width)
        table.focus()
        self.set_interval(0.1, self.drain)
        self.action_refresh()

    def action_refresh(self):
        if self.checking or self.updating:
            return
        self.tools.clear()
        self.errors.clear()
        self.selected.clear()
        self.done.clear()
        with _http_lock:
            _http_cache.clear()
        self.checking = True
        self.query_one('#status', Static).update('正在检查  ·  0 / 3 来源')
        self.render_table()
        collect(self.events.put)

    def drain(self):
        changed = False
        completed_check = False
        while not self.events.empty():
            kind, payload = self.events.get_nowait()
            if kind == 'tool':
                self.tools[payload.key] = payload
                changed = True
            elif kind == 'error':
                self.errors.append(payload)
            elif kind == 'group_done':
                self.done.add(payload)
                self.checking = len(self.done) < len(GROUPS)
                completed_check = not self.checking
                message = '正在检查  ·  %d / 3 来源' % len(self.done) if self.checking else '检查完成'
                if self.errors:
                    message += '  ·  ' + '; '.join('%s: %s' % e for e in self.errors)
                self.query_one('#status', Static).update(Text(message))
                changed = True
            elif kind == 'update_progress':
                completed, total, current, failed = payload
                self.query_one('#update-summary', Static).update(
                    '已处理 %d / %d · 成功 %d · 失败 %d' % (completed, total, completed - failed, failed))
                self.query_one('#status', Static).update(Text('正在更新 %s' % current if current else '更新任务已结束'))
            elif kind == 'update_item':
                key, stage, detail = payload
                progress = self.query_one('#update-items', DataTable)
                progress.update_cell(key, 'stage', Text(stage))
                progress.update_cell(key, 'detail', Text(detail[-1000:]))
            elif kind == 'update_done':
                self.updating = False
                self.query_one('#update-progress-box').remove_class('running')
                self.query_one('#table-box').display = True
                self.query_one('#detail').display = True
                self.last_update_result = payload
                self.query_one('#result-button', Button).disabled = False
                self.action_refresh()
                self.push_screen(UpdateResult(payload))
        if changed:
            self.render_table()
        if completed_check:
            self.query_one(DataTable).move_cursor(row=0)

    def matches(self, tool):
        source = self.query_one('#source', Select).value
        state = self.query_one('#state', Select).value
        query = self.query_one(Input).value.casefold().strip()
        return (source == 'all' or tool.group == source) and query in tool.name.casefold() and (
            state == 'all' or state == 'updates' and tool.outdated or
            state == 'fresh' and tool.state == 'done' and not tool.outdated and not tool.pinned or
            state == 'unknown' and tool.state == 'unknown' or state == 'pinned' and tool.pinned)

    def render_table(self):
        table = self.query_one(DataTable)
        old_key = self.filtered_tools[table.cursor_row].key if self.filtered_tools and table.cursor_row < len(self.filtered_tools) else None
        self.filtered_tools = [t for t in sorted(self.tools.values(), key=lambda t: t.sort_key) if self.matches(t)]
        table.clear()
        for tool in self.filtered_tools:
            status, color = ('未知', '#946000' if self.theme == 'bump-light' else '#e6b978') if tool.state == 'unknown' else (
                ('已固定', '#7050a0' if self.theme == 'bump-light' else '#a8a0ce') if tool.pinned else (('可更新', '#087e70' if self.theme == 'bump-light' else '#79e1c8') if tool.outdated else ('已最新', '#53667d' if self.theme == 'bump-light' else '#91a5bf')))
            if self.theme_mode == 'terminal':
                color = {'未知': 'yellow', '已固定': 'magenta', '可更新': 'green', '已最新': 'default'}[status]
            table.add_row('●' if tool.key in self.selected else '○' if tool.outdated else '·', Text(tool.name),
                          {'brew': 'Homebrew', 'npm': 'npm', 'self': '独立工具'}[tool.group],
                          Text(short_version(tool.local, 21) if tool.group == "self" else tool.local or "?"),
                          Text(short_version(tool.latest, 18) if tool.outdated else '—'), Text(status, style=color), key=tool.key)
        if old_key:
            row = next((i for i, t in enumerate(self.filtered_tools) if t.key == old_key), 0)
            table.move_cursor(row=row)
        values = list(self.tools.values())
        updates = sum(t.outdated for t in values)
        unknown = sum(t.state == 'unknown' for t in values)
        pinned = sum(t.pinned for t in values)
        fresh = sum(t.state == 'done' and not t.outdated and not t.pinned for t in values)
        for id_, text in [('installed', '%d\n已安装' % len(values)), ('updates', '%d\n可更新' % updates),
                          ('fresh', '%d\n已最新' % fresh), ('unknown', '%d / %d\n未知 / 固定' % (unknown, pinned))]:
            self.query_one('#' + id_, Static).update(text)
        counts = {g: sum(t.group == g for t in values) for g in GROUPS}
        self.query_one('#table-heading', Static).update('显示 %d / %d 项    ·    Homebrew %d    npm %d    独立工具 %d' %
            (len(self.filtered_tools), len(values), counts['brew'], counts['npm'], counts['self']))
        button = self.query_one('#update', Button)
        button.label = '更新所选 (%d)' % len(self.selected)
        button.disabled = not self.selected or self.checking or self.updating
        self.query_one('#refresh', Button).disabled = self.checking or self.updating
        if not self.filtered_tools:
            self.query_one('#detail', Static).update('没有匹配项' if not self.checking else '正在读取安装清单…')

    def on_input_changed(self, event):
        self.render_table()

    def on_select_changed(self, event):
        self.render_table()

    def on_data_table_row_highlighted(self, event):
        tool = self.tools.get(event.row_key.value)
        if tool:
            detail = tool.reason or '本地版本：%s  %s' % (tool.local, getattr(tool, 'description', ''))
            if getattr(tool, 'dependency', False):
                detail = '依赖包 · ' + detail
            self.query_one('#detail', Static).update(Text('%s  ·  %s' % (tool.name, detail)))

    def action_theme_toggle(self):
        self.theme_mode = THEME_MODES[(THEME_MODES.index(self.theme_mode) + 1) % len(THEME_MODES)]
        self.theme = 'bump-' + self.theme_mode
        self.screen.set_class(self.theme_mode == 'terminal', 'terminal-mode')
        self.query_one('#theme-toggle', Button).label = THEME_LABELS[self.theme_mode]
        try:
            save_theme_mode(self.theme_mode)
        except OSError as exc:
            self.notify('主题已切换，但保存失败：%s' % exc, severity='warning')
        self.render_table()

    def action_search(self):
        self.query_one(Input).focus()

    def action_toggle(self):
        if not self.query_one(DataTable).has_focus or self.updating:
            return
        row = self.query_one(DataTable).cursor_row
        if row < len(self.filtered_tools) and self.filtered_tools[row].outdated:
            self.selected.symmetric_difference_update({self.filtered_tools[row].key})
            self.render_table()

    def action_select_visible(self):
        if self.query_one(DataTable).has_focus and not self.updating:
            self.selected.update(t.key for t in self.filtered_tools if t.outdated)
            self.render_table()

    def action_clear(self):
        if not self.updating:
            self.selected.clear()
            self.render_table()

    def on_button_pressed(self, event):
        if event.button.id == 'theme-toggle':
            self.action_theme_toggle()
        elif event.button.id == 'result-button' and self.last_update_result:
            self.push_screen(UpdateResult(self.last_update_result))
        elif event.button.id == 'refresh':
            self.action_refresh()
        elif event.button.id == 'update':
            self.action_request_update()

    def action_request_update(self):
        if self.selected and not self.checking and not self.updating:
            targets = [t for t in self.tools.values() if t.key in self.selected and t.outdated]
            self.push_screen(ConfirmUpdate([t.name + (' · ' + t.description if t.key == 'uv' and getattr(t, 'description', '') else '') for t in targets]), lambda confirmed: self.begin_update(targets) if confirmed else None)

    def begin_update(self, targets):
        if not targets or self.updating:
            return
        self.query_one('#update-progress-box').add_class('active', 'running')
        self.query_one('#table-box').display = False
        self.query_one('#detail').display = False
        progress = self.query_one('#update-items', DataTable)
        progress.clear()
        for tool in targets:
            progress.add_row(Text(tool.name), '等待更新', '—', key=tool.key)
        self.query_one('#update-summary', Static).update('已处理 0 / %d · 成功 0 · 失败 0' % len(targets))
        self.updating = True
        self.render_table()
        self.run_worker(lambda: self.update_worker(targets), thread=True)

    def update_worker(self, targets):
        failures = []
        for index, tool in enumerate(targets, 1):
            self.events.put(('update_progress', (index - 1, len(targets), tool.name, len(failures))))
            self.events.put(('update_item', (tool.key, '正在执行', '等待更新命令输出…')))
            def on_output(line, key=tool.key, state=['正在执行']):
                state[0] = update_stage(line) or state[0]
                self.events.put(('update_item', (key, state[0], line)))
            try:
                ok, message = run_update(tool, on_output)
            except Exception as exc:
                ok, message = False, str(exc)
            if not ok:
                failures.append('%s\n命令：%s\n%s' % (tool.name, ' '.join(tool.update_cmd or []), message))
            self.events.put(('update_item', (tool.key, '更新成功' if ok else '更新失败',
                                             message.splitlines()[-1] if message else '命令执行完成')))
            self.events.put(('update_progress', (index, len(targets), None, len(failures))))
        message = '更新完成：%d 成功，%d 失败' % (len(targets) - len(failures), len(failures))
        if failures:
            message += '\n' + '\n'.join(failures)
        self.events.put(('update_done', message))

    def action_quit(self):
        if self.updating:
            self.notify('更新进行中，请等待完成', severity='warning')
        else:
            self.exit()


def run_tui():
    BumpApp().run()


# ── 入口 ──────────────────────────────────────────────────────────────────

def main(argv):
    parser = argparse.ArgumentParser(
        prog="bump",
        description="检查并更新本机安装的工具：Homebrew、npm 全局包、"
                    "以及自带更新命令的独立工具（bun、rustup、Rust、uv、opencode、pi、claude）",
    )
    parser.add_argument("--version", action="version", version="bump " + VERSION)
    parser.add_argument("-c", "--check", action="store_true",
                        help="只打印检查结果，不进入交互界面")
    parser.add_argument("--json", action="store_true", help="以 JSON 输出检查结果")
    parser.add_argument("--no-color", action="store_true", help="关闭彩色输出")
    args = parser.parse_args(argv)

    interactive = not (args.check or args.json) and sys.stdout.isatty() and sys.stdin.isatty()

    if interactive:
        return run_tui() or 0

    tools, errors = gather_blocking(None if args.json else print_progress)
    if not args.json:
        sys.stdout.write("\r" + " " * 60 + "\r")

    if args.json:
        payload = [
            {
                "name": t.name,
                "group": t.group,
                "local": t.local,
                "latest": t.latest,
                "outdated": t.outdated,
                "state": t.state,
                "reason": t.reason,
            }
            for t in sorted(tools, key=lambda t: t.sort_key)
        ]
        print(json.dumps({"tools": payload, "errors": errors}, indent=2, ensure_ascii=False))
        return 0

    return 1 if print_plain(tools, errors, color=not args.no_color) else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
