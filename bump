def preferences_path():
    root = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    return Path(root) / 'bump' / 'preferences.json'


def load_theme_mode():
    try:
        data = json.loads(preferences_path().read_text())
        mode = data.get('theme') if isinstance(data, dict) else None
        return mode if mode in THEME_MODES else 'dark'
    except (OSError, ValueError):
        return 'dark'


def save_theme_mode(mode):
    path = preferences_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps({'theme': mode}) + '\n')
    temporary.replace(path)


